generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis: CIDADAO (morador que agenda) e SECRETARIA (quem administra a rede).
model Usuario {
  id           String   @id @default(cuid())
  nome         String
  cpf          String   @unique // somente dígitos
  cns          String? // cartão SUS, somente dígitos
  nascimento   String // AAAA-MM-DD
  telefone     String?
  senhaHash    String
  role         String   @default("CIDADAO")
  criadoEm     DateTime @default(now())

  agendamentos Agendamento[]
}

/// Posto, UBS, unidade mista, centro de especialidades.
model Unidade {
  id            String   @id @default(cuid())
  nome          String
  slug          String   @unique
  tipo          String   @default("UBS")
  endereco      String
  bairro        String
  cidade        String
  uf            String
  telefone      String?
  funcionamento String   @default("Segunda a sexta, das 7h às 17h")
  observacao    String   @default("")
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  disponibilidades Disponibilidade[]
  bloqueios        Bloqueio[]
  agendamentos     Agendamento[]

  @@index([cidade, ativa])
}

/// Quantas vagas a unidade abre para uma especialidade num dia da semana e turno.
/// Ex.: Clínico Geral, quinta-feira, manhã, 20 vagas.
model Disponibilidade {
  id            String  @id @default(cuid())
  unidadeId     String
  unidade       Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  especialidade String
  diaSemana     Int // 0 = domingo … 6 = sábado
  turno         String // MANHA | TARDE
  vagas         Int     @default(10)
  ativa         Boolean @default(true)

  @@unique([unidadeId, especialidade, diaSemana, turno])
  @@index([unidadeId, especialidade])
}

/// Feriado, dedetização, falta de profissional: fecha a unidade naquele dia.
model Bloqueio {
  id        String   @id @default(cuid())
  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  data      String // AAAA-MM-DD
  motivo    String
  criadoEm  DateTime @default(now())

  @@unique([unidadeId, data])
}

/// Status: CONFIRMADO, CANCELADO, COMPARECEU, FALTOU.
model Agendamento {
  id            String   @id @default(cuid())
  protocolo     String   @unique
  unidadeId     String
  unidade       Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cidadaoId     String
  cidadao       Usuario  @relation(fields: [cidadaoId], references: [id], onDelete: Cascade)
  especialidade String
  data          String // AAAA-MM-DD
  turno         String // MANHA | TARDE
  status        String   @default("CONFIRMADO")
  observacao    String   @default("")
  criadoEm      DateTime @default(now())

  @@index([unidadeId, data, especialidade, turno, status])
  @@index([cidadaoId, data])
  @@index([data, status])
}
