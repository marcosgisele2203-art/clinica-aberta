# Banco Postgres. No Neon, copie a connection string DIRECT (sem "-pooler" no host).
# Formato: postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Chave usada para assinar o cookie de sessão. Invente uma sequência longa e aleatória.
# Se tiver Node por perto: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-32-bytes"

# Senha que libera a tela /configurar, usada uma única vez para criar as tabelas.
SETUP_TOKEN="invente-uma-senha-so-para-instalar"
